{
  "id": "vi.deplacer",
  "title": "Se déplacer et se loger",
  "subtitle": "Demander son chemin, prendre un scooter, trouver une chambre",
  "lexemes": [
    {
      "id": "vi.de.di",
      "term": "đi",
      "pos": "verb",
      "gloss": "aller",
      "note": "« Đi đâu? » = où vas-tu ? Sert aussi pour les moyens de transport : « đi xe máy » (aller en scooter), « đi bộ » (aller à pied).",
      "examples": [
        {
          "text": "Tôi muốn đi Hà Nội.",
          "fr": "Je veux aller à Hanoï."
        },
        {
          "text": "Đi bộ được không?",
          "fr": "On peut y aller à pied ?"
        }
      ],
      "roman": "di"
    },
    {
      "id": "vi.de.o-dau",
      "term": "ở đâu",
      "pos": "expr",
      "gloss": "où",
      "note": "Se place à la fin de la phrase, contrairement au français : « Nhà vệ sinh ở đâu? » = où sont les toilettes ?",
      "examples": [
        {
          "text": "Nhà vệ sinh ở đâu?",
          "fr": "Où sont les toilettes ?"
        },
        {
          "text": "Khách sạn ở đâu?",
          "fr": "Où est l'hôtel ?"
        }
      ],
      "roman": "eu daou"
    },
    {
      "id": "vi.de.xe-may",
      "term": "xe máy",
      "pos": "noun",
      "gloss": "scooter, moto",
      "note": "Le moyen de transport dominant. « Xe ôm » désigne le taxi-moto, omniprésent et souvent commandé par application.",
      "examples": [
        {
          "text": "Thuê xe máy bao nhiêu?",
          "fr": "Combien coûte la location d'un scooter ?"
        },
        {
          "text": "Đi xe ôm nhanh hơn.",
          "fr": "En taxi-moto, c'est plus rapide."
        }
      ],
      "roman": "sè maï"
    },
    {
      "id": "vi.de.khach-san",
      "term": "khách sạn",
      "pos": "noun",
      "gloss": "hôtel",
      "note": "« Nhà nghỉ » désigne une pension plus modeste, très répandue et bon marché.",
      "examples": [
        {
          "text": "Khách sạn này tốt.",
          "fr": "Cet hôtel est bien."
        },
        {
          "text": "Có phòng trống không?",
          "fr": "Avez-vous une chambre libre ?"
        }
      ],
      "roman": "khak sane"
    },
    {
      "id": "vi.de.phong",
      "term": "phòng",
      "pos": "noun",
      "gloss": "chambre, pièce",
      "note": "« Phòng đôi » = chambre double, « phòng đơn » = chambre simple, « phòng tắm » = salle de bain.",
      "examples": [
        {
          "text": "Có phòng đôi không?",
          "fr": "Avez-vous une chambre double ?"
        },
        {
          "text": "Phòng bao nhiêu một đêm?",
          "fr": "Combien coûte la chambre par nuit ?"
        }
      ],
      "roman": "fongue"
    },
    {
      "id": "vi.de.gan",
      "term": "gần",
      "pos": "adj",
      "gloss": "proche, près",
      "note": "« Gần đây » = près d'ici. Son contraire est « xa » (loin).",
      "examples": [
        {
          "text": "Có gần đây không?",
          "fr": "C'est près d'ici ?"
        },
        {
          "text": "Chợ gần đây không?",
          "fr": "Le marché est près d'ici ?"
        }
      ],
      "roman": "gane"
    },
    {
      "id": "vi.de.xa",
      "term": "xa",
      "pos": "adj",
      "gloss": "loin",
      "note": "« Xa quá » = c'est trop loin. Utile pour refuser une course de taxi-moto.",
      "examples": [
        {
          "text": "Xa không?",
          "fr": "C'est loin ?"
        },
        {
          "text": "Không xa lắm.",
          "fr": "Pas très loin."
        }
      ],
      "roman": "sa"
    },
    {
      "id": "vi.de.trai-phai",
      "term": "trái, phải",
      "pos": "noun",
      "gloss": "gauche, droite",
      "note": "« Rẽ trái » = tournez à gauche, « rẽ phải » = tournez à droite, « đi thẳng » = tout droit. Attention : « phải » veut aussi dire « devoir ».",
      "examples": [
        {
          "text": "Rẽ trái ở đây.",
          "fr": "Tournez à gauche ici."
        },
        {
          "text": "Đi thẳng rồi rẽ phải.",
          "fr": "Tout droit puis à droite."
        }
      ],
      "roman": "traï / faï"
    },
    {
      "id": "vi.de.dung-lai",
      "term": "dừng lại",
      "pos": "verb",
      "gloss": "s'arrêter",
      "note": "« Dừng lại ở đây » = arrêtez-vous ici. Indispensable en taxi ou en taxi-moto.",
      "examples": [
        {
          "text": "Dừng lại ở đây.",
          "fr": "Arrêtez-vous ici."
        },
        {
          "text": "Cho tôi xuống đây.",
          "fr": "Déposez-moi ici."
        }
      ],
      "roman": "zeung laï"
    },
    {
      "id": "vi.de.nha-ve-sinh",
      "term": "nhà vệ sinh",
      "pos": "noun",
      "gloss": "toilettes",
      "note": "Littéralement « maison d'hygiène ». On dit aussi « toilet », compris partout.",
      "examples": [
        {
          "text": "Nhà vệ sinh ở đâu?",
          "fr": "Où sont les toilettes ?"
        },
        {
          "text": "Cho hỏi nhà vệ sinh.",
          "fr": "Excusez-moi, les toilettes ?"
        }
      ],
      "roman": "gna vé sine"
    }
  ],
