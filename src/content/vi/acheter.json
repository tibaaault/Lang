{
  "id": "vi.acheter",
  "title": "Acheter et négocier",
  "subtitle": "Demander un prix, marchander, comprendre les montants",
  "lexemes": [
    {
      "id": "vi.ac.bao-nhieu",
      "term": "bao nhiêu",
      "pos": "adv",
      "gloss": "combien",
      "note": "« Bao nhiêu tiền? » = combien ça coûte ? C'est la phrase la plus utile du marché.",
      "examples": [
        {
          "text": "Cái này bao nhiêu?",
          "fr": "Ça coûte combien ?"
        },
        {
          "text": "Bao nhiêu tiền?",
          "fr": "Combien d'argent ?"
        }
      ],
      "roman": "bao nieou"
    },
    {
      "id": "vi.ac.tien",
      "term": "tiền",
      "pos": "noun",
      "gloss": "argent",
      "note": "« Tiền » se retrouve partout : « bao nhiêu tiền » (combien d'argent), « tính tiền » (l'addition), « đổi tiền » (changer de l'argent).",
      "examples": [
        {
          "text": "Tôi không có tiền mặt.",
          "fr": "Je n'ai pas d'espèces."
        },
        {
          "text": "Đổi tiền ở đâu?",
          "fr": "Où changer de l'argent ?"
        }
      ],
      "roman": "tienne"
    },
    {
      "id": "vi.ac.dat",
      "term": "đắt",
      "pos": "adj",
      "gloss": "cher",
      "note": "« Đắt quá! » (trop cher) ouvre la négociation, avec le sourire. Dans le Sud, on dit plutôt « mắc ».",
      "examples": [
        {
          "text": "Đắt quá!",
          "fr": "C'est trop cher !"
        },
        {
          "text": "Cái này đắt lắm.",
          "fr": "C'est vraiment cher."
        }
      ],
      "roman": "dat / mak (Sud)"
    },
    {
      "id": "vi.ac.re",
      "term": "rẻ",
      "pos": "adj",
      "gloss": "bon marché, pas cher",
      "note": "« Rẻ hơn được không? » = ça peut être moins cher ? C'est la contre-proposition à formuler après « đắt quá ».",
      "examples": [
        {
          "text": "Rẻ hơn được không?",
          "fr": "Ça peut être moins cher ?"
        },
        {
          "text": "Ở đây rẻ hơn.",
          "fr": "C'est moins cher ici."
        }
      ],
      "roman": "ré"
    },
    {
      "id": "vi.ac.mua",
      "term": "mua",
      "pos": "verb",
      "gloss": "acheter",
      "note": "« Mua » (acheter) et « bán » (vendre) forment le mot « mua bán », le commerce.",
      "examples": [
        {
          "text": "Tôi muốn mua cái này.",
          "fr": "Je veux acheter ceci."
        },
        {
          "text": "Mua ở đâu?",
          "fr": "Où l'acheter ?"
        }
      ],
      "roman": "moua"
    },
    {
      "id": "vi.ac.cai-nay",
      "term": "cái này",
      "pos": "expr",
      "gloss": "ceci, celui-ci",
      "note": "Formule de survie au marché : on montre du doigt en disant « cái này bao nhiêu? ». « Cái kia » = celui-là, plus loin.",
      "examples": [
        {
          "text": "Cái này bao nhiêu?",
          "fr": "Combien coûte celui-ci ?"
        },
        {
          "text": "Cho tôi cái kia.",
          "fr": "Donnez-moi celui-là."
        }
      ],
      "roman": "kaï naï"
    },
    {
      "id": "vi.ac.dong",
      "term": "đồng",
      "pos": "noun",
      "gloss": "dong (la monnaie)",
      "note": "Les montants sont énormes : un café coûte environ 25 000 đồng. À l'oral, on abrège souvent en milliers — « hai lăm » pour 25 000.",
      "examples": [
        {
          "text": "Năm mươi nghìn đồng.",
          "fr": "Cinquante mille dongs."
        },
        {
          "text": "Hai trăm nghìn.",
          "fr": "Deux cent mille."
        }
      ],
      "roman": "dongue"
    },
    {
      "id": "vi.ac.co-khong",
      "term": "có ... không?",
      "pos": "expr",
      "gloss": "avez-vous... ?",
      "note": "Structure de question la plus courante : on encadre le mot par « có » et « không ». « Có phòng không? » = avez-vous une chambre ?",
      "examples": [
        {
          "text": "Có phòng không?",
          "fr": "Avez-vous une chambre ?"
        },
        {
          "text": "Có wifi không?",
          "fr": "Y a-t-il du wifi ?"
        }
      ],
      "roman": "ko"
    },
    {
      "id": "vi.ac.qua",
      "term": "quá",
      "pos": "adv",
      "gloss": "trop, très",
      "note": "Se place après l'adjectif : « đắt quá » (trop cher), « ngon quá » (très bon). Selon le ton, il exprime l'excès ou l'admiration.",
      "examples": [
        {
          "text": "Đẹp quá!",
          "fr": "C'est très beau !"
        },
        {
          "text": "Xa quá.",
          "fr": "C'est trop loin."
        }
      ],
      "roman": "koua"
    },
    {
      "id": "vi.ac.khong-can",
      "term": "không cần",
      "pos": "expr",
      "gloss": "pas besoin, non merci",
      "note": "Refus poli face à un vendeur insistant : « không cần, cảm ơn ». Plus doux qu'un simple « không ».",
      "examples": [
        {
          "text": "Không cần, cảm ơn.",
          "fr": "Pas besoin, merci."
        },
        {
          "text": "Tôi không cần túi.",
          "fr": "Je n'ai pas besoin de sac."
        }
      ],
      "roman": "khong kane"
    }
  ],
