{
  "id": "eb.conversation",
  "title": "Phrases de conversation",
  "subtitle": "Les tournures qu'on entend sans arrêt dans les séries et les échanges",
  "lexemes": [
    {
      "id": "eb.cv.i-dont-know",
      "term": "I don't know",
      "pos": "expr",
      "gloss": "je ne sais pas",
      "note": "Se prononce souvent « aïdonno » à l'oral. La négation se construit avec « don't » + verbe.",
      "examples": [
        {
          "text": "I don't know what to say.",
          "fr": "Je ne sais pas quoi dire."
        },
        {
          "text": "I don't know yet.",
          "fr": "Je ne sais pas encore."
        }
      ]
    },
    {
      "id": "eb.cv.never-mind",
      "term": "never mind",
      "pos": "expr",
      "gloss": "laisse tomber, ce n'est pas grave",
      "note": "Sert à clore un sujet sans importance, ou à rassurer après une erreur.",
      "examples": [
        {
          "text": "Never mind, it's not important.",
          "fr": "Laisse tomber, ce n'est pas important."
        },
        {
          "text": "Never mind, I'll do it myself.",
          "fr": "Tant pis, je le ferai moi-même."
        }
      ]
    },
    {
      "id": "eb.cv.it-depends",
      "term": "it depends",
      "pos": "expr",
      "gloss": "ça dépend",
      "note": "Toujours avec un -s : « it depends ». Suivi de « on » : « it depends on the weather ».",
      "examples": [
        {
          "text": "It depends on the weather.",
          "fr": "Ça dépend du temps."
        },
        {
          "text": "It depends, why?",
          "fr": "Ça dépend, pourquoi ?"
        }
      ]
    },
    {
      "id": "eb.cv.no-worries",
      "term": "no worries",
      "pos": "expr",
      "gloss": "pas de souci, de rien",
      "note": "Répond à des excuses ou à un merci. « No problem » et « don't worry » sont équivalents.",
      "examples": [
        {
          "text": "No worries, it happens.",
          "fr": "Pas de souci, ça arrive."
        },
        {
          "text": "Thanks! — No worries.",
          "fr": "Merci ! — De rien."
        }
      ]
    },
    {
      "id": "eb.cv.hold-on",
      "term": "hold on",
      "pos": "expr",
      "gloss": "attends, une seconde",
      "note": "« Hold on » ou « hang on » à l'oral et au téléphone. « Wait » seul peut sembler sec.",
      "examples": [
        {
          "text": "Hold on a second.",
          "fr": "Attends une seconde."
        },
        {
          "text": "Hold on, I'll check.",
          "fr": "Attends, je vérifie."
        }
      ]
    },
    {
      "id": "eb.cv.i-guess",
      "term": "I guess",
      "pos": "expr",
      "gloss": "je suppose, j'imagine",
      "note": "Nuance d'incertitude ou d'accord tiède : « I guess so » = si tu veux, oui.",
      "examples": [
        {
          "text": "I guess you're right.",
          "fr": "Je suppose que tu as raison."
        },
        {
          "text": "I guess so.",
          "fr": "J'imagine, oui."
        }
      ]
    },
    {
      "id": "eb.cv.what-about",
      "term": "what about...?",
      "pos": "expr",
      "gloss": "et... ? qu'en est-il de... ?",
      "note": "Sert à proposer ou à relancer : « What about Friday? ». Suivi d'un nom ou d'un verbe en -ing.",
      "examples": [
        {
          "text": "What about Friday?",
          "fr": "Et vendredi ?"
        },
        {
          "text": "What about going out tonight?",
          "fr": "Et si on sortait ce soir ?"
        }
      ]
    },
    {
      "id": "eb.cv.by-the-way",
      "term": "by the way",
      "pos": "expr",
      "gloss": "au fait, à propos",
      "note": "Introduit une remarque annexe. Abrégé en « btw » à l'écrit informel.",
      "examples": [
        {
          "text": "By the way, did you call her?",
          "fr": "Au fait, tu l'as appelée ?"
        },
        {
          "text": "Nice shirt, by the way.",
          "fr": "Jolie chemise, au passage."
        }
      ]
    },
    {
      "id": "eb.cv.i-mean",
      "term": "I mean",
      "pos": "expr",
      "gloss": "enfin, je veux dire",
      "note": "Sert à préciser ou à se reprendre. « What do you mean? » = qu'est-ce que tu veux dire ?",
      "examples": [
        {
          "text": "I mean, it's not that simple.",
          "fr": "Enfin, ce n'est pas si simple."
        },
        {
          "text": "What do you mean?",
          "fr": "Qu'est-ce que tu veux dire ?"
        }
      ]
    },
    {
      "id": "eb.cv.take-care",
      "term": "take care",
      "pos": "expr",
      "gloss": "prends soin de toi, à bientôt",
      "note": "Formule d'au revoir chaleureuse, courante à l'oral et en fin de message.",
      "examples": [
        {
          "text": "See you, take care!",
          "fr": "À bientôt, prends soin de toi !"
        },
        {
          "text": "Take care of yourself.",
          "fr": "Prends soin de toi."
        }
      ]
    }
  ],
