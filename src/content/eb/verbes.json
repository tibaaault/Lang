{
  "id": "eb.verbes",
  "title": "Les verbes indispensables",
  "subtitle": "Dix verbes qui permettent déjà de dire presque tout",
  "lexemes": [
    {
      "id": "eb.vb.be",
      "term": "to be",
      "pos": "verb",
      "gloss": "être",
      "note": "Le verbe le plus fréquent de l'anglais : I am, you are, he/she/it is, we are, they are. Il sert aussi pour l'âge : « I am 25 » (j'ai 25 ans), jamais « I have 25 ».",
      "examples": [
        {
          "text": "I am tired.",
          "fr": "Je suis fatigué."
        },
        {
          "text": "She is my sister.",
          "fr": "C'est ma sœur."
        }
      ]
    },
    {
      "id": "eb.vb.have",
      "term": "to have",
      "pos": "verb",
      "gloss": "avoir",
      "note": "I have, you have, he/she/it has, we have, they have. Le « has » à la troisième personne est la seule irrégularité.",
      "examples": [
        {
          "text": "I have two brothers.",
          "fr": "J'ai deux frères."
        },
        {
          "text": "He has a car.",
          "fr": "Il a une voiture."
        }
      ]
    },
    {
      "id": "eb.vb.go",
      "term": "to go",
      "pos": "verb",
      "gloss": "aller",
      "note": "« Go to » + lieu : « go to work ». Exception : « go home », sans « to ».",
      "examples": [
        {
          "text": "I go to work by bus.",
          "fr": "Je vais au travail en bus."
        },
        {
          "text": "Let's go home.",
          "fr": "Rentrons à la maison."
        }
      ]
    },
    {
      "id": "eb.vb.want",
      "term": "to want",
      "pos": "verb",
      "gloss": "vouloir",
      "note": "Toujours suivi de « to » + verbe : « I want to go ». Pour être poli, on dit « I would like » plutôt que « I want ».",
      "examples": [
        {
          "text": "I want to learn English.",
          "fr": "Je veux apprendre l'anglais."
        },
        {
          "text": "I'd like a coffee, please.",
          "fr": "Je voudrais un café, s'il vous plaît."
        }
      ]
    },
    {
      "id": "eb.vb.need",
      "term": "to need",
      "pos": "verb",
      "gloss": "avoir besoin de",
      "note": "« I need to go » = je dois y aller. « I need a break » = j'ai besoin d'une pause. Jamais « I have need of ».",
      "examples": [
        {
          "text": "I need to go.",
          "fr": "Je dois y aller."
        },
        {
          "text": "Do you need help?",
          "fr": "Tu as besoin d'aide ?"
        }
      ]
    },
    {
      "id": "eb.vb.like",
      "term": "to like",
      "pos": "verb",
      "gloss": "aimer bien, apprécier",
      "note": "Suivi d'un verbe en -ing : « I like reading ». « I love » est plus fort, « I don't like » plus poli que « I hate ».",
      "examples": [
        {
          "text": "I like this song.",
          "fr": "J'aime bien cette chanson."
        },
        {
          "text": "She likes cooking.",
          "fr": "Elle aime cuisiner."
        }
      ]
    },
    {
      "id": "eb.vb.know",
      "term": "to know",
      "pos": "verb",
      "gloss": "savoir, connaître",
      "note": "Un seul verbe pour les deux sens français. « I don't know » (je ne sais pas) est l'une des phrases les plus utiles.",
      "examples": [
        {
          "text": "I don't know.",
          "fr": "Je ne sais pas."
        },
        {
          "text": "Do you know her?",
          "fr": "Tu la connais ?"
        }
      ]
    },
    {
      "id": "eb.vb.get",
      "term": "to get",
      "pos": "verb",
      "gloss": "obtenir, recevoir ; devenir",
      "note": "Verbe à tout faire : « get a coffee » (prendre un café), « get home » (rentrer), « get tired » (se fatiguer).",
      "examples": [
        {
          "text": "I got your message.",
          "fr": "J'ai reçu ton message."
        },
        {
          "text": "It's getting late.",
          "fr": "Il se fait tard."
        }
      ]
    },
    {
      "id": "eb.vb.think",
      "term": "to think",
      "pos": "verb",
      "gloss": "penser, croire",
      "note": "« I think so » = je crois que oui. « I don't think so » = je ne crois pas. Deux réponses très courantes.",
      "examples": [
        {
          "text": "I think it's a good idea.",
          "fr": "Je pense que c'est une bonne idée."
        },
        {
          "text": "I don't think so.",
          "fr": "Je ne crois pas."
        }
      ]
    },
    {
      "id": "eb.vb.can",
      "term": "can",
      "pos": "verb",
      "gloss": "pouvoir, savoir faire",
      "note": "Suivi du verbe sans « to » : « I can swim », jamais « I can to swim ». La négation est « can't ».",
      "examples": [
        {
          "text": "I can swim.",
          "fr": "Je sais nager."
        },
        {
          "text": "Can you help me?",
          "fr": "Tu peux m'aider ?"
        }
      ]
    }
  ],
