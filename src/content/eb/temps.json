{
  "id": "eb.temps",
  "title": "Le temps et les quantités",
  "subtitle": "Dire quand, combien, et à quelle fréquence",
  "lexemes": [
    {
      "id": "eb.tp.today",
      "term": "today",
      "pos": "adv",
      "gloss": "aujourd'hui",
      "note": "« Today », « tomorrow » (demain), « yesterday » (hier). Trois mots à connaître ensemble.",
      "examples": [
        {
          "text": "What are you doing today?",
          "fr": "Tu fais quoi aujourd'hui ?"
        },
        {
          "text": "I saw her yesterday.",
          "fr": "Je l'ai vue hier."
        }
      ]
    },
    {
      "id": "eb.tp.always",
      "term": "always",
      "pos": "adv",
      "gloss": "toujours",
      "note": "Se place entre le sujet et le verbe : « I always forget », jamais « I forget always ».",
      "examples": [
        {
          "text": "I always forget his name.",
          "fr": "J'oublie toujours son prénom."
        },
        {
          "text": "She's always late.",
          "fr": "Elle est toujours en retard."
        }
      ]
    },
    {
      "id": "eb.tp.never",
      "term": "never",
      "pos": "adv",
      "gloss": "jamais",
      "note": "« Never » est déjà négatif : on ne met pas « don't » avec. « I never go » et non « I don't never go ».",
      "examples": [
        {
          "text": "I never drink coffee.",
          "fr": "Je ne bois jamais de café."
        },
        {
          "text": "He's never on time.",
          "fr": "Il n'est jamais à l'heure."
        }
      ]
    },
    {
      "id": "eb.tp.sometimes",
      "term": "sometimes",
      "pos": "adv",
      "gloss": "parfois, quelquefois",
      "note": "Un seul mot, avec un -s. « Sometime » sans -s signifie « un de ces jours ».",
      "examples": [
        {
          "text": "Sometimes I work late.",
          "fr": "Parfois je travaille tard."
        },
        {
          "text": "I sometimes forget.",
          "fr": "Il m'arrive d'oublier."
        }
      ]
    },
    {
      "id": "eb.tp.often",
      "term": "often",
      "pos": "adv",
      "gloss": "souvent",
      "note": "Le « t » ne se prononce généralement pas : « offen ». « How often? » = à quelle fréquence ?",
      "examples": [
        {
          "text": "I often go there.",
          "fr": "J'y vais souvent."
        },
        {
          "text": "How often do you train?",
          "fr": "Tu t'entraînes à quelle fréquence ?"
        }
      ]
    },
    {
      "id": "eb.tp.a-lot",
      "term": "a lot",
      "pos": "expr",
      "gloss": "beaucoup",
      "note": "En deux mots : « a lot ». « A lot of » devant un nom : « a lot of people ». Ne jamais écrire « alot ».",
      "examples": [
        {
          "text": "Thanks a lot!",
          "fr": "Merci beaucoup !"
        },
        {
          "text": "There were a lot of people.",
          "fr": "Il y avait beaucoup de monde."
        }
      ]
    },
    {
      "id": "eb.tp.a-little",
      "term": "a little",
      "pos": "expr",
      "gloss": "un peu",
      "note": "« A little » devant ce qui ne se compte pas (a little water), « a few » devant ce qui se compte (a few days).",
      "examples": [
        {
          "text": "I speak a little English.",
          "fr": "Je parle un peu anglais."
        },
        {
          "text": "Give me a few minutes.",
          "fr": "Donne-moi quelques minutes."
        }
      ]
    },
    {
      "id": "eb.tp.too-much",
      "term": "too much",
      "pos": "expr",
      "gloss": "trop",
      "note": "« Too much » devant ce qui ne se compte pas, « too many » devant ce qui se compte. « Too » seul veut dire « trop » devant un adjectif.",
      "examples": [
        {
          "text": "That's too much for me.",
          "fr": "C'est trop pour moi."
        },
        {
          "text": "There are too many people.",
          "fr": "Il y a trop de monde."
        }
      ]
    },
    {
      "id": "eb.tp.enough",
      "term": "enough",
      "pos": "adj",
      "gloss": "assez, suffisamment",
      "note": "Se place APRÈS l'adjectif : « good enough », et non « enough good ». Devant un nom, en revanche : « enough time ».",
      "examples": [
        {
          "text": "That's good enough.",
          "fr": "C'est suffisant."
        },
        {
          "text": "We don't have enough time.",
          "fr": "Nous n'avons pas assez de temps."
        }
      ]
    },
    {
      "id": "eb.tp.soon",
      "term": "soon",
      "pos": "adv",
      "gloss": "bientôt",
      "note": "« See you soon! » = à bientôt ! Ne pas confondre avec « early » (tôt).",
      "examples": [
        {
          "text": "See you soon!",
          "fr": "À bientôt !"
        },
        {
          "text": "It'll be ready soon.",
          "fr": "Ce sera prêt bientôt."
        }
      ]
    }
  ],
