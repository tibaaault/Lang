{
  "id": "eb.quotidien",
  "title": "La journée",
  "subtitle": "Raconter ce qu'on fait dans une journée ordinaire",
  "lexemes": [
    {
      "id": "eb.qt.wake-up",
      "term": "to wake up",
      "pos": "verb",
      "gloss": "se réveiller",
      "note": "« Wake up » = se réveiller, « get up » = se lever. Les deux sont différents et souvent confondus.",
      "examples": [
        {
          "text": "I wake up at seven.",
          "fr": "Je me réveille à sept heures."
        },
        {
          "text": "I get up ten minutes later.",
          "fr": "Je me lève dix minutes plus tard."
        }
      ]
    },
    {
      "id": "eb.qt.breakfast",
      "term": "breakfast",
      "pos": "noun",
      "gloss": "le petit-déjeuner",
      "note": "« Have breakfast » et non « take breakfast ». Les trois repas : breakfast, lunch, dinner.",
      "examples": [
        {
          "text": "I have breakfast at eight.",
          "fr": "Je prends le petit-déjeuner à huit heures."
        },
        {
          "text": "What's for dinner?",
          "fr": "Qu'est-ce qu'on mange ce soir ?"
        }
      ]
    },
    {
      "id": "eb.qt.work",
      "term": "to work",
      "pos": "verb",
      "gloss": "travailler ; fonctionner",
      "note": "Deux sens : « I work in a shop » et « it doesn't work » (ça ne marche pas).",
      "examples": [
        {
          "text": "I work from home.",
          "fr": "Je travaille à la maison."
        },
        {
          "text": "It doesn't work.",
          "fr": "Ça ne marche pas."
        }
      ]
    },
    {
      "id": "eb.qt.tired",
      "term": "tired",
      "pos": "adj",
      "gloss": "fatigué",
      "note": "« I'm tired » et non « I have tired ». En anglais, les états se disent avec « be ».",
      "examples": [
        {
          "text": "I'm really tired today.",
          "fr": "Je suis vraiment fatiguée aujourd'hui."
        },
        {
          "text": "Are you tired?",
          "fr": "Tu es fatigué ?"
        }
      ]
    },
    {
      "id": "eb.qt.hungry",
      "term": "hungry",
      "pos": "adj",
      "gloss": "affamé, qui a faim",
      "note": "« I'm hungry » = j'ai faim ; « I'm thirsty » = j'ai soif. Toujours avec « be ».",
      "examples": [
        {
          "text": "I'm hungry.",
          "fr": "J'ai faim."
        },
        {
          "text": "Are you thirsty?",
          "fr": "Tu as soif ?"
        }
      ]
    },
    {
      "id": "eb.qt.busy",
      "term": "busy",
      "pos": "adj",
      "gloss": "occupé, pris",
      "note": "« I'm busy » = je suis occupé. « A busy street » = une rue passante.",
      "examples": [
        {
          "text": "Sorry, I'm busy tonight.",
          "fr": "Désolée, je suis prise ce soir."
        },
        {
          "text": "It's a busy day.",
          "fr": "C'est une journée chargée."
        }
      ]
    },
    {
      "id": "eb.qt.late",
      "term": "late",
      "pos": "adj",
      "gloss": "en retard ; tard",
      "note": "« I'm late » = je suis en retard. « Early » est le contraire : tôt, en avance.",
      "examples": [
        {
          "text": "Sorry I'm late.",
          "fr": "Désolée, je suis en retard."
        },
        {
          "text": "I woke up early today.",
          "fr": "Je me suis réveillée tôt aujourd'hui."
        }
      ]
    },
    {
      "id": "eb.qt.watch",
      "term": "to watch",
      "pos": "verb",
      "gloss": "regarder (un film, une série)",
      "note": "Trois verbes à distinguer : « watch » (regarder longuement), « see » (voir), « look at » (regarder brièvement).",
      "examples": [
        {
          "text": "I watch series every night.",
          "fr": "Je regarde des séries tous les soirs."
        },
        {
          "text": "Look at this!",
          "fr": "Regarde ça !"
        }
      ]
    },
    {
      "id": "eb.qt.sleep",
      "term": "to sleep",
      "pos": "verb",
      "gloss": "dormir",
      "note": "« Sleep » = dormir ; « go to bed » = aller se coucher. « I slept well » = j'ai bien dormi.",
      "examples": [
        {
          "text": "I slept badly last night.",
          "fr": "J'ai mal dormi cette nuit."
        },
        {
          "text": "I go to bed at eleven.",
          "fr": "Je me couche à onze heures."
        }
      ]
    },
    {
      "id": "eb.qt.every-day",
      "term": "every day",
      "pos": "expr",
      "gloss": "tous les jours",
      "note": "En deux mots. Attention : « everyday » en un mot est un adjectif qui signifie « quotidien, ordinaire ».",
      "examples": [
        {
          "text": "I study English every day.",
          "fr": "J'étudie l'anglais tous les jours."
        },
        {
          "text": "It's an everyday problem.",
          "fr": "C'est un problème quotidien."
        }
      ]
    }
  ],
