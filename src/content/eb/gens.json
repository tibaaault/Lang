{
  "id": "eb.gens",
  "title": "Les gens et les sentiments",
  "subtitle": "Parler de ses proches et de ce qu'on ressent",
  "lexemes": [
    {
      "id": "eb.gn.friend",
      "term": "a friend",
      "pos": "noun",
      "gloss": "un ami, une amie",
      "note": "Même mot pour les deux genres. « A friend of mine » = un ami à moi.",
      "examples": [
        {
          "text": "She's a friend of mine.",
          "fr": "C'est une amie à moi."
        },
        {
          "text": "We're good friends.",
          "fr": "Nous sommes de bons amis."
        }
      ]
    },
    {
      "id": "eb.gn.family",
      "term": "family",
      "pos": "noun",
      "gloss": "la famille",
      "note": "« My family is... » au singulier en anglais américain. Les membres : mother, father, sister, brother, parents.",
      "examples": [
        {
          "text": "My family lives in Lyon.",
          "fr": "Ma famille habite à Lyon."
        },
        {
          "text": "I have a big family.",
          "fr": "J'ai une grande famille."
        }
      ]
    },
    {
      "id": "eb.gn.happy",
      "term": "happy",
      "pos": "adj",
      "gloss": "content, heureux",
      "note": "« I'm happy » et non « I have happy ». « Happy about » ou « happy with » selon ce qui suit.",
      "examples": [
        {
          "text": "I'm happy for you.",
          "fr": "Je suis contente pour toi."
        },
        {
          "text": "She looks happy.",
          "fr": "Elle a l'air heureuse."
        }
      ]
    },
    {
      "id": "eb.gn.sad",
      "term": "sad",
      "pos": "adj",
      "gloss": "triste",
      "note": "« I'm sad » = je suis triste. « Sad about something » = triste à propos de.",
      "examples": [
        {
          "text": "Why are you sad?",
          "fr": "Pourquoi es-tu triste ?"
        },
        {
          "text": "It's a sad story.",
          "fr": "C'est une histoire triste."
        }
      ]
    },
    {
      "id": "eb.gn.angry",
      "term": "angry",
      "pos": "adj",
      "gloss": "en colère, fâché",
      "note": "« Angry with someone » (contre quelqu'un) mais « angry about something » (à propos de quelque chose). « Mad » est la version familière.",
      "examples": [
        {
          "text": "She's angry with me.",
          "fr": "Elle est en colère contre moi."
        },
        {
          "text": "Don't be angry.",
          "fr": "Ne te fâche pas."
        }
      ]
    },
    {
      "id": "eb.gn.love",
      "term": "to love",
      "pos": "verb",
      "gloss": "aimer (fort), adorer",
      "note": "Plus fort que « like ». S'emploie aussi pour les choses : « I love this song ».",
      "examples": [
        {
          "text": "I love this song.",
          "fr": "J'adore cette chanson."
        },
        {
          "text": "I love my family.",
          "fr": "J'aime ma famille."
        }
      ]
    },
    {
      "id": "eb.gn.miss",
      "term": "to miss",
      "pos": "verb",
      "gloss": "manquer (à quelqu'un) ; rater",
      "note": "Attention à l'inversion : « I miss you » veut dire « tu me manques ». Le sujet est celui qui ressent le manque.",
      "examples": [
        {
          "text": "I miss you.",
          "fr": "Tu me manques."
        },
        {
          "text": "I missed the bus.",
          "fr": "J'ai raté le bus."
        }
      ]
    },
    {
      "id": "eb.gn.feel",
      "term": "to feel",
      "pos": "verb",
      "gloss": "se sentir, ressentir",
      "note": "« I feel tired » et non « I feel me tired » : le verbe n'est pas réfléchi en anglais.",
      "examples": [
        {
          "text": "I feel much better today.",
          "fr": "Je me sens beaucoup mieux aujourd'hui."
        },
        {
          "text": "How do you feel?",
          "fr": "Comment te sens-tu ?"
        }
      ]
    },
    {
      "id": "eb.gn.nice",
      "term": "nice",
      "pos": "adj",
      "gloss": "gentil, sympa, agréable",
      "note": "Mot passe-partout : une personne sympathique, un moment agréable, un objet joli. « That's nice » convient partout.",
      "examples": [
        {
          "text": "She's really nice.",
          "fr": "Elle est vraiment sympa."
        },
        {
          "text": "Have a nice day!",
          "fr": "Bonne journée !"
        }
      ]
    },
    {
      "id": "eb.gn.together",
      "term": "together",
      "pos": "adv",
      "gloss": "ensemble",
      "note": "« We live together » = on vit ensemble. Ne se met jamais avec « with » : jamais « together with me » dans ce sens.",
      "examples": [
        {
          "text": "Let's do it together.",
          "fr": "Faisons-le ensemble."
        },
        {
          "text": "They work together.",
          "fr": "Ils travaillent ensemble."
        }
      ]
    }
  ],
