{
  "id": "eb.questions",
  "title": "Poser une question",
  "subtitle": "Les mots interrogatifs et la façon de construire une question",
  "lexemes": [
    {
      "id": "eb.qu.what",
      "term": "what",
      "pos": "adv",
      "gloss": "quoi, quel",
      "note": "« What is it? » = qu'est-ce que c'est ? « What time? » = à quelle heure ?",
      "examples": [
        {
          "text": "What is your name?",
          "fr": "Comment tu t'appelles ?"
        },
        {
          "text": "What time is it?",
          "fr": "Quelle heure est-il ?"
        }
      ]
    },
    {
      "id": "eb.qu.where",
      "term": "where",
      "pos": "adv",
      "gloss": "où",
      "note": "« Where are you? » = tu es où ? « Where from? » = d'où ?",
      "examples": [
        {
          "text": "Where do you live?",
          "fr": "Tu habites où ?"
        },
        {
          "text": "Where are you from?",
          "fr": "Tu viens d'où ?"
        }
      ]
    },
    {
      "id": "eb.qu.when",
      "term": "when",
      "pos": "adv",
      "gloss": "quand",
      "note": "« When? » pour le moment. Ne pas confondre avec « where » (où) : les deux mots se ressemblent beaucoup.",
      "examples": [
        {
          "text": "When do you start?",
          "fr": "Tu commences quand ?"
        },
        {
          "text": "When is your birthday?",
          "fr": "C'est quand, ton anniversaire ?"
        }
      ]
    },
    {
      "id": "eb.qu.who",
      "term": "who",
      "pos": "adv",
      "gloss": "qui",
      "note": "Pour les personnes uniquement. « Who is it? » = qui est-ce ?",
      "examples": [
        {
          "text": "Who is that?",
          "fr": "C'est qui ?"
        },
        {
          "text": "Who told you?",
          "fr": "Qui te l'a dit ?"
        }
      ]
    },
    {
      "id": "eb.qu.why",
      "term": "why",
      "pos": "adv",
      "gloss": "pourquoi",
      "note": "On répond avec « because » (parce que). « Why not? » = pourquoi pas ?",
      "examples": [
        {
          "text": "Why are you late?",
          "fr": "Pourquoi tu es en retard ?"
        },
        {
          "text": "Because the bus was late.",
          "fr": "Parce que le bus était en retard."
        }
      ]
    },
    {
      "id": "eb.qu.how",
      "term": "how",
      "pos": "adv",
      "gloss": "comment",
      "note": "« How are you? » = comment vas-tu ? « How much? » = combien (prix) ? « How many? » = combien (nombre) ?",
      "examples": [
        {
          "text": "How are you?",
          "fr": "Comment vas-tu ?"
        },
        {
          "text": "How much is it?",
          "fr": "Ça coûte combien ?"
        }
      ]
    },
    {
      "id": "eb.qu.do-question",
      "term": "do you...?",
      "pos": "expr",
      "gloss": "est-ce que tu... ?",
      "note": "Pour poser une question au présent, on met « do » (ou « does » avec he, she, it) devant le sujet. Le verbe qui suit ne change pas.",
      "examples": [
        {
          "text": "Do you speak English?",
          "fr": "Tu parles anglais ?"
        },
        {
          "text": "Does she work here?",
          "fr": "Elle travaille ici ?"
        }
      ]
    },
    {
      "id": "eb.qu.is-there",
      "term": "is there...?",
      "pos": "expr",
      "gloss": "est-ce qu'il y a... ?",
      "note": "« There is » = il y a (singulier), « there are » = il y a (pluriel). En question, on inverse : « Is there...? ».",
      "examples": [
        {
          "text": "Is there a toilet here?",
          "fr": "Il y a des toilettes ici ?"
        },
        {
          "text": "There are two options.",
          "fr": "Il y a deux options."
        }
      ]
    },
    {
      "id": "eb.qu.can-you",
      "term": "can you...?",
      "pos": "expr",
      "gloss": "peux-tu... ? (demande polie)",
      "note": "« Can you help me? » est la façon standard de demander un service. « Could you...? » est encore plus poli.",
      "examples": [
        {
          "text": "Can you repeat, please?",
          "fr": "Tu peux répéter, s'il te plaît ?"
        },
        {
          "text": "Could you speak slowly?",
          "fr": "Pourriez-vous parler lentement ?"
        }
      ]
    },
    {
      "id": "eb.qu.which",
      "term": "which",
      "pos": "adv",
      "gloss": "lequel, quel (parmi un choix)",
      "note": "« Which one? » = lequel ? On emploie « which » quand le choix est limité, « what » quand il est ouvert.",
      "examples": [
        {
          "text": "Which one do you prefer?",
          "fr": "Lequel préfères-tu ?"
        },
        {
          "text": "Which day works for you?",
          "fr": "Quel jour t'arrange ?"
        }
      ]
    }
  ],
