{
  "id": "id.rencontre",
  "title": "Rencontrer et discuter",
  "subtitle": "Engager la conversation, se présenter, comprendre les questions qu'on vous pose",
  "lexemes": [
    {
      "id": "id.rc.apa-kabar",
      "term": "apa kabar?",
      "pos": "expr",
      "gloss": "comment ça va ?",
      "note": "Réponse habituelle : « baik » (bien) ou « baik-baik saja » (ça va bien). Littéralement « quelles nouvelles ? ».",
      "examples": [
        {
          "text": "Apa kabar?",
          "fr": "Comment ça va ?"
        },
        {
          "text": "Baik, terima kasih.",
          "fr": "Bien, merci."
        }
      ]
    },
    {
      "id": "id.rc.siapa",
      "term": "siapa",
      "pos": "adv",
      "gloss": "qui",
      "note": "« Siapa nama Anda? » = comment vous appelez-vous ? Littéralement « qui est votre nom ? », tournure propre à l'indonésien.",
      "examples": [
        {
          "text": "Siapa nama Anda?",
          "fr": "Comment vous appelez-vous ?"
        },
        {
          "text": "Siapa itu?",
          "fr": "Qui est-ce ?"
        }
      ]
    },
    {
      "id": "id.rc.nama",
      "term": "nama",
      "pos": "noun",
      "gloss": "nom, prénom",
      "note": "« Nama saya... » = je m'appelle... C'est la présentation de base, à retenir en priorité.",
      "examples": [
        {
          "text": "Nama saya Thibault.",
          "fr": "Je m'appelle Thibault."
        },
        {
          "text": "Nama panggilan saya Tib.",
          "fr": "Mon surnom est Tib."
        }
      ]
    },
    {
      "id": "id.rc.dari-mana",
      "term": "dari mana?",
      "pos": "expr",
      "gloss": "d'où venez-vous ?",
      "note": "Question posée systématiquement aux étrangers. Réponse : « saya dari Prancis » (je viens de France).",
      "examples": [
        {
          "text": "Anda dari mana?",
          "fr": "Vous venez d'où ?"
        },
        {
          "text": "Saya dari Prancis.",
          "fr": "Je viens de France."
        }
      ]
    },
    {
      "id": "id.rc.tinggal",
      "term": "tinggal",
      "pos": "verb",
      "gloss": "habiter, rester",
      "note": "« Saya tinggal di Paris » = j'habite à Paris. Toujours suivi de « di » pour le lieu.",
      "examples": [
        {
          "text": "Saya tinggal di Paris.",
          "fr": "J'habite à Paris."
        },
        {
          "text": "Berapa lama tinggal di sini?",
          "fr": "Combien de temps restez-vous ici ?"
        }
      ]
    },
    {
      "id": "id.rc.kerja",
      "term": "kerja",
      "pos": "verb",
      "gloss": "travailler ; travail",
      "note": "« Kerja apa? » = vous faites quoi comme travail ? « Bekerja » est la forme verbale complète, plus soutenue.",
      "examples": [
        {
          "text": "Anda kerja apa?",
          "fr": "Vous faites quoi comme travail ?"
        },
        {
          "text": "Saya kerja di kantor.",
          "fr": "Je travaille dans un bureau."
        }
      ]
    },
    {
      "id": "id.rc.senang",
      "term": "senang",
      "pos": "adj",
      "gloss": "content, heureux",
      "note": "« Senang bertemu Anda » = enchanté de vous rencontrer. Formule de politesse à connaître.",
      "examples": [
        {
          "text": "Senang bertemu Anda.",
          "fr": "Enchanté de vous rencontrer."
        },
        {
          "text": "Saya senang di sini.",
          "fr": "Je me plais ici."
        }
      ]
    },
    {
      "id": "id.rc.teman",
      "term": "teman",
      "pos": "noun",
      "gloss": "ami",
      "note": "« Teman saya » = mon ami. Le possessif se place après le nom, contrairement au français.",
      "examples": [
        {
          "text": "Ini teman saya.",
          "fr": "Voici mon ami."
        },
        {
          "text": "Saya datang dengan teman.",
          "fr": "Je viens avec un ami."
        }
      ]
    },
    {
      "id": "id.rc.mengerti",
      "term": "mengerti",
      "pos": "verb",
      "gloss": "comprendre",
      "note": "« Saya tidak mengerti » = je ne comprends pas, l'une des phrases les plus utiles du voyage. « Paham » en est un synonyme courant.",
      "examples": [
        {
          "text": "Saya tidak mengerti.",
          "fr": "Je ne comprends pas."
        },
        {
          "text": "Anda mengerti bahasa Inggris?",
          "fr": "Vous comprenez l'anglais ?"
        }
      ]
    },
    {
      "id": "id.rc.pelan",
      "term": "pelan-pelan",
      "pos": "adv",
      "gloss": "lentement, doucement",
      "note": "« Tolong bicara pelan-pelan » = parlez lentement, s'il vous plaît. Le redoublement du mot renforce le sens, procédé très fréquent en indonésien.",
      "examples": [
        {
          "text": "Tolong bicara pelan-pelan.",
          "fr": "Parlez lentement, s'il vous plaît."
        },
        {
          "text": "Pelan-pelan saja.",
          "fr": "Doucement, sans se presser."
        }
      ]
    }
  ],
