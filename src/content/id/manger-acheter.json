{
  "id": "id.manger-acheter",
  "title": "Manger, acheter, s'orienter",
  "subtitle": "Les phrases dont on se sert vraiment tous les jours sur place",
  "lexemes": [
    {
      "id": "id.ma.berapa",
      "term": "berapa",
      "pos": "adv",
      "gloss": "combien",
      "note": "« Berapa harganya? » (combien ça coûte ?) est la phrase la plus utile du voyage. Se prononce « beu-ra-pa ».",
      "examples": [
        { "text": "Berapa harganya?", "fr": "Combien ça coûte ?" },
        { "text": "Berapa lama?", "fr": "Combien de temps ?" }
      ]
    },
    {
      "id": "id.ma.mahal",
      "term": "mahal",
      "pos": "adj",
      "gloss": "cher",
      "note": "Au marché, « terlalu mahal » (trop cher) ouvre la négociation. Marchander se fait avec le sourire, jamais sèchement.",
      "examples": [
        { "text": "Terlalu mahal!", "fr": "C'est trop cher !" },
        { "text": "Ini mahal sekali.", "fr": "C'est vraiment cher." }
      ]
    },
    {
      "id": "id.ma.murah",
      "term": "murah",
      "pos": "adj",
      "gloss": "bon marché, pas cher",
      "note": "« Lebih murah » = moins cher. C'est la contre-proposition à formuler après « terlalu mahal ».",
      "examples": [
        { "text": "Bisa lebih murah?", "fr": "Ça peut être moins cher ?" },
        { "text": "Di sini lebih murah.", "fr": "C'est moins cher ici." }
      ]
    },
    {
      "id": "id.ma.air",
      "term": "air",
      "pos": "noun",
      "gloss": "eau",
      "note": "Se prononce en deux syllabes, « a-ir », et non comme le mot français. « Air putih » (eau blanche) désigne l'eau plate à boire.",
      "examples": [
        { "text": "Saya mau air putih.", "fr": "Je voudrais de l'eau plate." },
        { "text": "Air ini dingin.", "fr": "Cette eau est froide." }
      ]
    },
    {
      "id": "id.ma.makan",
      "term": "makan",
      "pos": "verb",
      "gloss": "manger",
      "note": "« Makanan » = la nourriture, « rumah makan » = un restaurant (littéralement : maison où l'on mange).",
      "examples": [
        { "text": "Saya mau makan.", "fr": "Je voudrais manger." },
        { "text": "Makanan ini enak.", "fr": "Ce plat est délicieux." }
      ]
    },
    {
      "id": "id.ma.enak",
      "term": "enak",
      "pos": "adj",
      "gloss": "bon (au goût), agréable",
      "note": "Compliment universel sur la nourriture, et toujours bien reçu. S'emploie aussi pour un moment agréable.",
      "examples": [
        { "text": "Enak sekali!", "fr": "C'est vraiment bon !" },
        { "text": "Nasi gorengnya enak.", "fr": "Le riz frit est bon." }
      ]
    },
    {
      "id": "id.ma.pedas",
      "term": "pedas",
      "pos": "adj",
      "gloss": "épicé, piquant",
      "note": "À retenir avant tout le reste : « tidak pedas » (pas épicé). En Indonésie, « un peu épicé » dépasse souvent ce qu'un palais français encaisse.",
      "examples": [
        { "text": "Tidak pedas, ya.", "fr": "Pas épicé, d'accord ?" },
        { "text": "Ini pedas sekali!", "fr": "C'est très épicé !" }
      ]
    },
    {
      "id": "id.ma.di-mana",
      "term": "di mana",
      "pos": "expr",
      "gloss": "où (se trouve)",
      "note": "« Di mana toilet? » = où sont les toilettes ? On place « di mana » après ce qu'on cherche, ou en tête de phrase.",
      "examples": [
        { "text": "Toilet di mana?", "fr": "Où sont les toilettes ?" },
        { "text": "Di mana stasiun?", "fr": "Où est la gare ?" }
      ]
    },
    {
      "id": "id.ma.kiri",
      "term": "kiri",
      "pos": "noun",
      "gloss": "gauche",
      "note": "« Kiri » (gauche) et « kanan » (droite). Dans un bus ou un taxi partagé, crier « kiri! » signifie « arrêtez-moi ici ».",
      "examples": [
        { "text": "Belok kiri.", "fr": "Tournez à gauche." },
        { "text": "Kiri, Pak!", "fr": "Arrêtez ici, monsieur !" }
      ]
    },
    {
      "id": "id.ma.kanan",
      "term": "kanan",
      "pos": "noun",
      "gloss": "droite",
      "note": "« Belok kanan » = tournez à droite. « Lurus » veut dire tout droit.",
      "examples": [
        { "text": "Belok kanan di lampu merah.", "fr": "Tournez à droite au feu rouge." },
        { "text": "Rumahnya di sebelah kanan.", "fr": "La maison est sur la droite." }
      ]
    }
  ],
