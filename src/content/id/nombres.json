{
  "id": "id.nombres",
  "title": "Nombres et temps",
  "subtitle": "Compter, dire l'heure et situer dans le temps",
  "lexemes": [
    {
      "id": "id.nb.satu-lima",
      "term": "satu, dua, tiga, empat, lima",
      "pos": "noun",
      "gloss": "un, deux, trois, quatre, cinq",
      "note": "Se prononcent « sa-tou, dou-a, ti-ga, eum-pat, li-ma ». Le « u » se dit toujours « ou ».",
      "examples": [
        {
          "text": "Dua kopi, tolong.",
          "fr": "Deux cafés, s'il vous plaît."
        },
        {
          "text": "Untuk tiga orang.",
          "fr": "Pour trois personnes."
        }
      ]
    },
    {
      "id": "id.nb.enam-sepuluh",
      "term": "enam, tujuh, delapan, sembilan, sepuluh",
      "pos": "noun",
      "gloss": "six, sept, huit, neuf, dix",
      "note": "« Sepuluh » (dix) sert de base : onze se dit « sebelas », vingt « dua puluh », cent « seratus ».",
      "examples": [
        {
          "text": "Sepuluh ribu rupiah.",
          "fr": "Dix mille roupies."
        },
        {
          "text": "Jam tujuh pagi.",
          "fr": "Sept heures du matin."
        }
      ]
    },
    {
      "id": "id.nb.ribu",
      "term": "ribu",
      "pos": "noun",
      "gloss": "mille",
      "note": "Indispensable : les prix indonésiens se comptent en milliers de roupies. « Lima puluh ribu » = cinquante mille.",
      "examples": [
        {
          "text": "Dua puluh ribu rupiah.",
          "fr": "Vingt mille roupies."
        },
        {
          "text": "Berapa ribu?",
          "fr": "Combien de milliers ?"
        }
      ]
    },
    {
      "id": "id.nb.jam",
      "term": "jam",
      "pos": "noun",
      "gloss": "heure ; montre",
      "note": "« Jam berapa? » = quelle heure est-il ? « Jam delapan » = huit heures. Le mot désigne aussi la montre.",
      "examples": [
        {
          "text": "Jam berapa sekarang?",
          "fr": "Quelle heure est-il maintenant ?"
        },
        {
          "text": "Jam delapan malam.",
          "fr": "Huit heures du soir."
        }
      ]
    },
    {
      "id": "id.nb.sekarang",
      "term": "sekarang",
      "pos": "adv",
      "gloss": "maintenant",
      "note": "Se prononce « seu-ka-rang ». Souvent raccourci en « skarang » à l'oral.",
      "examples": [
        {
          "text": "Sekarang atau nanti?",
          "fr": "Maintenant ou plus tard ?"
        },
        {
          "text": "Saya sibuk sekarang.",
          "fr": "Je suis occupé maintenant."
        }
      ]
    },
    {
      "id": "id.nb.nanti",
      "term": "nanti",
      "pos": "adv",
      "gloss": "plus tard, tout à l'heure",
      "note": "« Nanti malam » = ce soir. « Sampai nanti » = à tout à l'heure.",
      "examples": [
        {
          "text": "Nanti saja.",
          "fr": "Plus tard, tout simplement."
        },
        {
          "text": "Sampai nanti!",
          "fr": "À tout à l'heure !"
        }
      ]
    },
    {
      "id": "id.nb.besok",
      "term": "besok",
      "pos": "adv",
      "gloss": "demain",
      "note": "« Besok pagi » = demain matin. « Lusa » signifie après-demain.",
      "examples": [
        {
          "text": "Sampai besok!",
          "fr": "À demain !"
        },
        {
          "text": "Besok pagi jam tujuh.",
          "fr": "Demain matin à sept heures."
        }
      ]
    },
    {
      "id": "id.nb.kemarin",
      "term": "kemarin",
      "pos": "adv",
      "gloss": "hier",
      "note": "Se prononce « keu-ma-rin ». « Kemarin malam » = hier soir.",
      "examples": [
        {
          "text": "Saya tiba kemarin.",
          "fr": "Je suis arrivé hier."
        },
        {
          "text": "Kemarin hujan.",
          "fr": "Hier il a plu."
        }
      ]
    },
    {
      "id": "id.nb.hari",
      "term": "hari",
      "pos": "noun",
      "gloss": "jour",
      "note": "« Hari ini » = aujourd'hui, littéralement « ce jour ». « Setiap hari » = tous les jours.",
      "examples": [
        {
          "text": "Hari ini panas sekali.",
          "fr": "Aujourd'hui il fait très chaud."
        },
        {
          "text": "Setiap hari saya belajar.",
          "fr": "Tous les jours j'étudie."
        }
      ]
    },
    {
      "id": "id.nb.lama",
      "term": "lama",
      "pos": "adj",
      "gloss": "long (durée) ; ancien",
      "note": "« Berapa lama? » = combien de temps ? « Sudah lama » = ça fait longtemps. Le contraire est « sebentar » (un instant).",
      "examples": [
        {
          "text": "Berapa lama dari sini?",
          "fr": "C'est à combien de temps d'ici ?"
        },
        {
          "text": "Tunggu sebentar.",
          "fr": "Attendez un instant."
        }
      ]
    }
  ],
