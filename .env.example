# Copier ce fichier en `.env.local` pour travailler en local avec la
# synchronisation. Sans ces deux valeurs, l'application fonctionne quand même :
# la progression reste alors sur l'appareil.
#
# Les deux valeurs se trouvent dans Supabase → Project Settings → API.
# La clé « anon » est publique par conception : elle ne donne accès à rien
# par elle-même, ce sont les politiques RLS qui décident.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
